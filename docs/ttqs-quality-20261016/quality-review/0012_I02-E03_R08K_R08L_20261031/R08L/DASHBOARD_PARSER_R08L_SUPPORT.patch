+                    baseline.get("visual_verdict") == "PASS" and
+                    int(baseline.get("rendered_page_count", 0)) == page_count):
+                parent_ok = True
+                break
+        if not parent_ok:
+            return False
+        pdf_sha = str(obj.get("pdf_sha256", "")).lower()
+        if not re.fullmatch(r"[0-9a-f]{64}", pdf_sha):
+            return False
+        return any(p.is_file() and sha256_file(p).lower() == pdf_sha
+                   for p in qa_root.rglob("*.pdf"))
+    except (OSError, TypeError, ValueError, AttributeError):
+        return False
