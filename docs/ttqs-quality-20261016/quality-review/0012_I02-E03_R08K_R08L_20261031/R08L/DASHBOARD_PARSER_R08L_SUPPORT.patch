+def _ttqs_0012_r08l_visual_pass(obj, receipt_path, expected_sha):
+    """Validate the Word-rendered R08L page delta against the exact R08K baseline."""
+    try:
+        if (receipt_path is None or str(obj.get("candidate_sha256", "")).lower() != str(expected_sha or "").lower() or
+                obj.get("visual_verdict") != "PASS" or obj.get("all_other_pages_pixel_identical") is not True or
+                "microsoft word" not in str(obj.get("render_engine", "")).lower()):
+            return False
+        page_count = int(obj.get("page_count", 0))
+        parent_sha = str(obj.get("parent_candidate_sha256", "")).lower()
+        if page_count != 29 or not re.fullmatch(r"[0-9a-f]{64}", parent_sha):
+            return False
+        identical = {int(x) for x in obj.get("pixel_identical_pages", [])}
+        changed_rows = obj.get("changed_pages")
+        if not isinstance(changed_rows, list) or len(changed_rows) != 1:
+            return False
+        row = changed_rows[0]
+        direct_note = str(row.get("direct_original_size_inspection", ""))
+        if (int(row.get("page", 0)) != 16 or not PASS_WORD.search(direct_note) or
+                re.search(r"FAIL|PARTIAL|BLOCKED|未通過", direct_note, re.I) or
+                not all(token in direct_note.lower() for token in ("no clipping", "overlap")) or
+                identical != (set(range(1, page_count + 1)) - {16})):
+            return False
+        qa_root = receipt_path.parent.parent
+        parent_ok = False
+        for baseline_path in qa_root.rglob("VISUAL_QA_R08K.json"):
