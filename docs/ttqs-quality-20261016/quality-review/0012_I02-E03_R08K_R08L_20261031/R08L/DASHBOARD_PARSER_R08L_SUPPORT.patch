+def _ttqs_0012_r08l_technical_pass(obj, receipt_path, expected_sha):
+    """Validate the source-bound R08L delta receipt and its R08K font baseline."""
+    try:
+        if (receipt_path is None or str(obj.get("candidate_sha256", "")).lower() != str(expected_sha or "").lower() or
+                obj.get("technical_verdict") != "PASS" or obj.get("python_docx_open") != "PASS" or
+                obj.get("openxml_zip_crc") != "PASS" or obj.get("exact_locator_fix") != "PASS" or
+                int(obj.get("table_count", 0)) != 18 or
+                obj.get("package_member_diff") != ["word/document.xml"] or
+                obj.get("all_other_package_parts_identical") is not True or
+                "single exact text substitution" not in str(obj.get("document_xml_diff", "")).lower() or
+                "unchanged_from_r08k" not in str(obj.get("font_properties", "")).lower() or
+                not str(obj.get("numerics", "")).upper().startswith("UNCHANGED")):
+            return False
+        parent_sha = str(obj.get("parent_sha256", "")).lower()
+        for key in ("source_pdf_sha256", "blueprint_file_sha256", "blueprint_row_sha256"):
+            if not re.fullmatch(r"[0-9a-f]{64}", str(obj.get(key, "")).lower()):
+                return False
+        if not re.fullmatch(r"[0-9a-f]{64}", parent_sha):
+            return False
+        qa_root = receipt_path.parent.parent
+        for baseline_path in qa_root.rglob("TECHNICAL_QA_R08K.json"):
+            baseline = read_json(baseline_path)
+            if (str(baseline.get("candidate_sha256", "")).lower() == parent_sha and
+                    baseline.get("verdict") == "PASS" and
+                    float(baseline.get("body_min_font_pt", 0)) >= 10.5 and
+                    float(baseline.get("table_min_font_pt", 0)) >= 9.5):
+                return True
+        return False
+    except (OSError, TypeError, ValueError, AttributeError):
+        return False
+
