var TTQS_R3_CANONICAL_EXEC_URL_='https://script.google.com/macros/s/AKfycbznbXi-0XWNV68E-vGU9CiAE6ElXGIlDmy27EePXMdGpRaorURzKZq0dDgsNBaaZOLh/exec';
var TTQS_R3_FROZEN_ARTIFACT_={artifactId:'FA-DEMO-002',releaseId:'ER-DEMO-20260901-DRAFT-001',documentTitle:'TTQS ONE｜Implementation Contract CONTROL｜2026-08-19 DRAFT R3',sourceObject:'CONTROL_SNAPSHOT:IMPLEMENTATION_CONTRACT_R3',dataClass:'CONTROL',environment:'TEST',pdfFilename:'IMPLEMENTATION_CONTRACT_CONTROL_R3.pdf',pdfSha256:'d5b2cfd922918e873bdd604659f661277db2a4d0734403d6a46e85e371c984fd',textSha256:'6109440d6a8d5ef7c0757d02cb33342ba9ffbd5267ffdff48b8110ffed0656a1',offlineRelativePath:'artifacts/IMPLEMENTATION_CONTRACT_CONTROL_R3.pdf',requiredContentMarkers:['四、FrozenArtifact enforcement（F-01/F-02）','ER-03: 委員主查驗路徑以 frozen copy 為準']};
var TTQS_R3_FROZEN_TEXT_="TTQS ONE｜Implementation Contract CONTROL｜2026-08-19 DRAFT R3\n\n控制定位\n- project_id: TTQS_ONE\n- phase: T_TEST_RELEASE\n- environment: TEST\n- data_class: CONTROL\n- contract_status: DRAFT_CONTROL_FOR_HUMAN_REVIEW\n- routing_authority: NONE_UNTIL_MISSION_PUBLISHED\n- purpose: 定義 Mission HUMAN 原文所引用之資料模型、不變式、權力邊界、T0→T5 施工切線與 T Gate\n出場規則。本文件不是 REAL 辦訓事證、不是 TTQS 官方評分表，也不自行發布 Mission。\n\n一、Mission Revision 完整性錨定（D-01）\nMission revision 發布時保留 HUMAN_TEXT_V1 對九個 HUMAN 原文產生 mission_text_hash，另加入\n下列非敘事錨定欄位：\n- implementation_contract_doc_id\n- implementation_contract_version_date\n- implementation_contract_sha256\n並增加 mission_revision_envelope_hash，計算輸入至少包含 project_id、mission_revision_id、\nmission_text_hash、implementation_contract_doc_id、implementation_contract_version_date、\nimplementation_contract_sha256。如此既保留人類控制面原文差異偵測，又把 HUMAN 原文引用的概念\n定義鎖入同一 revision envelope。附件更新不得沿用舊 implementation_contract_sha256；必須建立新\nsnapshot 並由新的 Mission revision 明確引用。\n\n二、T Gate CONTROL 錨（D-02）\n本實施契約錨定以下 T Gate CONTROL snapshot：\n- source_control_doc_id: 19oxnYUdJROF3Tw4NdHtMYFvN2rku80FKAnvfRRbSy2A\n- snapshot_file_id: 15X-4zvUsP9SUW0aeeYAA0MREgb-YFXo3\n- version_date: 2026-08-19\n- sha256: b24854b3cd7a98aee46111f9f0a325e498404716f9530f2202abdf5c4f4198be\n- title: TTQS_ONE_T_GATE_EXIT_CRITERIA_CONTROL_20260819_R3_SNAPSHOT.pdf\n該 snapshot 固定 19 項 T_TEST_RELEASE 出場條件；其內容若改動，必須產生新 snapshot、更新本契\n約，再由新的 Mission revision 錨定，不得在 9/1 壓力下原地放寬而不留版本軌跡。\n\n三、文件生命週期與核准鏈（R-01）\nDocumentVersion 狀態：DRAFT → WORKING；WORKING 可送審後進 RETURNED、REJECTED 或\nAPPROVED；RETURNED 可修後形成新的送審 revision；REJECTED 表示該次版本決策終止；\nAPPROVED 後可進 EFFECTIVE，再進 SUPERSEDED；錯誤建立或治理撤銷可 VOID。\n硬不變式：\nDV-01: version_status=APPROVED ⇒ approval_event_id 不得為空。\nDV-02: ApprovalEvent 必記 document_version_id、source_file_id、source_revision_id_at_decision、\ndecision、approver_alias_id、approver_role、decision_at、evidence_reviewed、rationale、conditions。\nDV-03: 核准者看到的 source_revision_id_at_decision 被固定；核准後 WorkingSource 若改動，不得沿用\n舊 ApprovalEvent 宣稱新內容已核准。\nFROZEN 僅為 EvaluationRelease 對 DocumentVersion 或 Evidence 之凍結關係，非文件或證據本身之\n全域狀態；日常文件與證據仍可依其生命週期產生後續版本或狀態，不改寫既有送評 snapshot。\n\n四、FrozenArtifact enforcement（F-01/F-02）\n可引用的固定內容身份由 DocumentVersion＋source revision＋frozen export＋SHA-256 構成。Google\nnative source 以 source_revision_id 判斷來源內容版本；Drive binary source 以 provider checksum 識\n別；frozen export 本體另計 artifact_sha256。modifiedTime 禁止作內容指紋。\n\fFrozenArtifact 至少含 artifact_id、document_version_id/source_object_id、source_file_id、\nsource_revision_id/provider_checksum、export_format、export_filename、artifact_sha256、size_bytes\n、frozen_storage_id、offline_relative_path、contains_pii、masking_status、generated_at、verified_at。\n\n五、EvaluationRelease\n狀態機：DRAFT_RELEASE → LOCKED → SUBMITTED → ARCHIVED。LOCKED 後不得原地解鎖修\n改內容；需要變更建立新 Release 並以 supersedes_release_id 連結。\n欄位至少含 release_id、release_type、evaluation_case_id、application_no、evaluation_scope、\nevaluation_date、cutoff_at、release_data_cutoff_at、official_rule_version、status、\ncreated_at/created_by、locked_at/locked_by、supersedes_release_id、artifact_count_total、\nmanifest_sha256。\nER-01: LOCK 時 artifact_count_total 固定，且必須等於 manifest 實際 FrozenArtifact 數量。\nER-02: release_data_cutoff_at 表示該 Release 所涵蓋資料事實的截止時間，不與行政／評核時點\ncutoff_at 混用。\nER-03: 委員主查驗路徑以 frozen copy 為準；Drive live link 僅為內部便利或受控工作站現場調閱，不得成\n為主路徑必要條件。\n\n六、REAL 可採認性與利益迴避（D-03/R-04）\nformal_admissibility 至少有 TEST_ONLY、SAMPLE_ONLY、CONTROL_ONLY、REAL_CANDIDATE、\nREAL_APPROVED、REAL_REJECTED、REAL_WITHDRAWN。\nREAL_APPROVED 必須有獨立 AdmissibilityDecision：admissibility_decision_id、evidence_id、\ndecision、decided_by、decided_role、decided_at、decision_basis、evidence_reviewed、audit_event_id\n。\nAD-01: REAL_APPROVED ⇒ data_class=REAL。\nAD-02: REAL_APPROVED ⇒ 具名人類 AdmissibilityDecision 存在，且對應 AdminAuditLog 人控事件\n存在。\nAD-03: AI、Script、HEALTHY 狀態、一般 ApprovalEvent 或修改 tag 均不得推升為 REAL_APPROVED。\nAD-04 利益迴避：AdmissibilityDecision.decided_by 不得為該 Evidence 的建立者。若 B／C 由同一自然\n人兼任，第一個 REAL ClassRun 所形成之首批 REAL_APPROVED Evidence 必須由 A 覆核並留下獨立\naudit event；任何後續 Evidence 若仍發生建立者與決策者為同一自然人的衝突，仍不得自行核准，須改由\n具獨立性的角色決策或 A 覆核。\n\n七、核心 Sheets DB 完整性（R-02/M-08）\nGoogle Sheets provider revision history 不作核心資料庫不可竄改保證。核心 DB 完整性由兩層控制：\n1. AdminAuditLog append-only：audit_event_id、actor_alias_id、actor_role、action_type、object_type、\nobject_id、before_fingerprint、after_fingerprint、changed_fields、request_id、event_at、result。\n2. CoreBackupSnapshot：snapshot_id、source_database_id、export_format、generated_at、\nartifact_sha256、storage_id、previous_snapshot_id、restore_test_status、restore_tested_at。\n初始節奏：每日 snapshot 保留 35 天；每月 snapshot 保留 13 個月；被 EvaluationRelease 引用之\nsnapshot 不受一般清理；正常每季還原演練一次，正式 Release 前至少再做一次；C 主責、B readback，重\n大不可恢復事件升級 A。\n\n八、個資與保存\nEvidence／Artifact schema 預留 contains_pii、pii_class、display_policy、masked_artifact_id、\noriginal_access_mode。可用顯示政策：FULL、MASKED、AGGREGATE_ONLY、\nON_SITE_ORIGINAL_ONLY。未遮罩 PII 不得由匿名評核入口公開。\n保存 schema 使用既有 retention_class，並補 retention_policy_id、retention_basis、retention_start_at、\nscheduled_disposal_at、disposal_status。REAL 啟動前必完成 Retention Policy Gate；未驗證法規、補\n助、契約或個資依據前不得自行猜統一保存年限。\n\n九、內部 readiness 與官方佐證表\n\fSelfAssessment 本期只允許 assessment_type=INTERNAL_READINESS，保存 readiness_status、\nrationale、evidence_assertion_ids、gap_ids、assessor_alias_id、assessed_at；不設官方 score。\nOfficialEvidenceChecklistDraft 依官方訓練機構版查核佐證文件資料表 1→19、12a–12e、17a–17d 的列\n序保存 official_reference_option_id、suggested_selected、other_evidence_name、source_title、\nsource_locator、page_reference、supporting_evidence_ids、review_status。其唯讀展示版為 9/1 與未來\n正式評核的「官方佐證表視圖」。\nPriorEvaluationFinding 僅建長期模型：prior_finding_id、prior_evaluation_case_id、indicator_id、\nfinding_text、source_document_id/source_locator、required_action、owner_role、status、\nevidence_of_improvement_ids、verified_at/verified_by；首次正式受評標\nNOT_APPLICABLE_FIRST_ASSESSMENT。\n\n十、三介面與權限隔離\n單一證據核心支援：內部可寫營運控制台、外部唯讀評核入口、Offline Pack。外部唯讀入口與內部可寫控制\n台必須分開 deployment 或以等效強隔離權限面實作；外部 runtime 不得取得核心 DB 寫入能力。正式委員\n／顧問路徑採三層：公開無個資 frozen、遮罩 frozen、受控工作站現場原件。\n\n十一、可自主執行／人工核准／永不允許（G-01）\n可自主執行：CONTROL 官方依據存證與 hash；唯讀 Drive／GitHub／Portal／Offline 驗證；\nTEST/SAMPLE fixture 建立、修正、退役但保留歷史；引用完整性、STALE、時序、PII、hash、red-team 檢\n查；TEST CoreBackupSnapshot 與還原演練；TEST/SAMPLE/CONTROL Offline Pack；已由人類核准之\nT0→T5 範圍內可逆 TEST schema／程式／UI 修正；既有 EXTERNAL_READONLY 安全邊界內 TEST\nPortal 更新；Gap Register 如實記錄與 readback。\n必須人工核准：任一 Mission revision 發布或 Phase 變更；Human T Gate PASS；任何 REAL 寫入或\nREAL Start；PROD 啟用；第一門 REAL 課程鎖定；正式 TTQS 評分／牌等宣稱；A/B/C 真實治理\nApprovalEvent；REAL_CANDIDATE→REAL_APPROVED；正式 EvaluationRelease LOCK／SUBMIT；\n官方平台正式送件；未遮罩 PII 對外開放；永久銷毀正式證據／稽核紀錄。\n永久禁止繞過：SAMPLE→REAL；AI／Script 自動 REAL_APPROVED；以 runtime／CI／exactly-once 代\n替辦訓事證；改寫舊 FrozenArtifact；原地改寫已發布 Mission 歷史 revision。\n\n十二、9/1 Cut Line 與時程（S-01）\nT0：首屏真實身分、REAL=0、19/19 改為介面覆蓋、系統能力／正式事證雙軸。\nT1：DocumentVersion、ApprovalEvent、AdmissibilityDecision、EvaluationRelease、FrozenArtifact、\nAdminAuditLog、CoreBackupSnapshot、PII／retention schema 與不變式。\nT1B：舊時序倒掛 SAMPLE deprecated；建立乾淨 fixture；人工引用完整性報告。\nT2：Evidence Matrix＋官方佐證表視圖。\nT3：EvaluationRelease v1＋manifest＋Offline Pack；若滑期，降級為管理員預建靜態包，不犧牲 T4。\nT4a：2026-08-26～08-27 與 T3 並行，先跑效能與 Chrome clean／Chrome 單一帳號／Safari private／\nBrave incognito 瀏覽器矩陣。效能預算：冷啟動≤8秒、暖啟動≤3秒、指標→Matrix≤2秒、靜態\nFrozenArtifact≤2秒；超標但未超過 2 倍者只進 Gap Register 並在 9/1 明示顧問，僅超過對應預算 2 倍者\n升 MUST_FIX_PERFORMANCE。\n2026-08-27 23:59 feature freeze；其後只允許 blocker、回歸、證據與資安修正。\nT4b：freeze 後至 8/28 排演前完成 3-click、clean browser、顧問自有裝置，或非開發機、非協會管理工作站\n之獨立裝置斷網查驗。\n2026-08-28 內部 Red Team：以該日為 BLOCKER／MUST_FIX 清零基準；N-03 官方設計依據圖像頁由\n人眼對官方原頁比對，並在 Gap Register 記錄核對人、日期、結果。\n2026-08-30 顧問型預演：不懂系統的人操作，不允許工程人員口頭救援。8/30 後新增 finding 預設進 Gap\nRegister，不阻擋 T Gate；只有資料真實性或 SAMPLE 冒 REAL 類 finding 可重新觸發 BLOCKER。\n2026-09-01 T Gate：顧問本人實機，最終 PASS 僅能由人類決定。\n\n十三、T Gate 完整清單\n\f完整 19 項出場條件以第二節錨定之 T Gate CONTROL snapshot 為唯一當版清單；本契約不以摘要覆蓋\n該清單。該 snapshot 與本契約任一內容不一致時，Mission 發布前必須先產生新契約版本解決矛盾，不允\n許帶矛盾發布。\n\n十四、回退原則\n資料模型採 additive migration，不刪舊資料；舊 SAMPLE 保留 regression 歷史。Apps Script TEST 施工\n前記錄 deployment/version；回退使用既有已驗證 TEST 基線，不 force-rewrite Git 歷史。Mission 舊\nrevision 永不覆寫；策略撤回只能新增 superseding revision。現有 10 頁 Offline Snapshot 保留為既有\nfailover 基線，新 Offline Pack 另建。\n\n十五、控制規則\n1. 本文件本身是 DRAFT CONTROL，不具有 Mission routing authority；只有人類逐字確認九個 HUMAN\n原文與本契約 snapshot anchor，並正式發布新 Mission revision 後才具有被 Mission 引用的權威。\n2. 本文件內容若改動，必須重新輸出 snapshot 並計算新的 SHA-256；不得沿用舊\nimplementation_contract_sha256。\n3. Mission revision envelope 必須同時錨定 HUMAN_TEXT_V1 mission_text_hash 與本契約 snapshot；\n只驗九個 HUMAN 原文而未驗附件錨，不得宣稱該 revision 完整發布。\n4. 禁令持續有效：目前無 REAL、無正式評分、無 PROD；本 CONTROL 文件建立不構成上述任一行為。\n\f";
