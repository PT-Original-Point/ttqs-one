function ttqsR3ArtifactHtml_(id){var artifact=TTQS_R3_FROZEN_ARTIFACT_;var requested=String(id||'');if(requested!==artifact.artifactId)return ttqsR3ArtifactErrorHtml_(requested);var markers=artifact.requiredContentMarkers.map(function(marker){return '<li>'+esc_(marker)+'</li>';}).join('');return '<!doctype html><html lang=\"zh-Hant-TW\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>'+esc_(artifact.documentTitle)+'</title><style>'+css_()+'.r3artifact{max-width:1100px;margin:20px auto}.r3warning{background:#fff2d9;border:1px solid #e1c47d;border-radius:12px;padding:12px;line-height:1.6}.r3artifact pre{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.65;background:#fff;border:1px solid #d9e2e8;border-radius:12px;padding:16px}.r3tech{font-size:12px;color:#435563}.r3tech code{overflow-wrap:anywhere}</style></head><body><main class=\"r3artifact\" data-artifact-id=\"'+esc_(artifact.artifactId)+'\" data-release-id=\"'+esc_(artifact.releaseId)+'\" data-frozen-pdf-sha256=\"'+esc_(artifact.pdfSha256)+'\" data-offline-relative-path=\"'+esc_(artifact.offlineRelativePath)+'\"><section class=\"r3panel\"><div class=\"r3warning\"><b>模擬評核查驗｜TEST／CONTROL｜非正式事證</b><br>本頁只供測試與控制查驗；不是協會 REAL 辦訓紀錄，不得用於正式 TTQS 評分或官方送件。</div><h1>'+esc_(artifact.documentTitle)+'</h1><p>這是已凍結 PDF 的 build-time 靜態 HTML 檢視；runtime 不查詢 live Drive。下方文字由同一 frozen PDF 於 build-time 以 pdftotext -layout 產生，PDF 仍保留在同一 EvaluationRelease 的 Offline Pack。</p><pre class=\"frozen-text\">'+esc_(TTQS_R3_FROZEN_TEXT_)+'</pre><details class=\"r3tech\"><summary>技術細節（管理員用）</summary><p>DEMO FrozenArtifact projection · TEST/SAMPLE/CONTROL · EXTERNAL_READONLY</p><table class=\"r3table\"><tr><th>artifact_id</th><td>'+esc_(artifact.artifactId)+'</td></tr><tr><th>release_id</th><td>'+esc_(artifact.releaseId)+'</td></tr><tr><th>source object</th><td>'+esc_(artifact.sourceObject)+'</td></tr><tr><th>frozen PDF</th><td>'+esc_(artifact.pdfFilename)+'</td></tr><tr><th>PDF SHA-256</th><td>'+esc_(artifact.pdfSha256)+'</td></tr><tr><th>文字投影 SHA-256</th><td>'+esc_(artifact.textSha256)+'</td></tr><tr><th>Offline Pack</th><td>'+esc_(artifact.offlineRelativePath)+'</td></tr><tr><th>required_content_markers</th><td><ul>'+markers+'</ul></td></tr><tr><th>REAL</th><td>NO — 本 artifact 不構成 REAL 辦訓事證或正式 TTQS 評分</td></tr></table></details><p><a class=\"button\" href=\"'+esc_(TTQS_R3_CANONICAL_EXEC_URL_)+'\">返回評核入口</a></p></section></main></body></html>';}
