r3CardsHtml_=function(){var cardParts=[];for(var i=1;i<=19;i++){var r=TTQS_INDICATORS_[i-1];var subs=r[6]?r[6].split('|').map(function(x){return '<span class=\"chip\">'+esc_(x)+'</span>';}).join(''):'';var adm=r[3]==='FORMAL_BLOCKED_NEEDS_REAL'?'NO_REAL_EVENT':(r[3]==='EVIDENCE_MISSING'?'GAP':'TEST/SAMPLE/CONTROL_ONLY');cardParts.push('<article class=\"r3card\"><h3>'+r[0]+'｜'+esc_(r[2])+'</h3><div class=\"axis ok\"><b>系統能力</b><span>TEST_EVIDENCE_PATH_AVAILABLE</span></div><div class=\"axis warn\"><b>正式可評事證</b><span>'+r[3]+'</span></div><div>'+subs+'</div><details><summary>查看佐證與來源｜Evidence Matrix</summary><table class=\"r3table\"><tr><th>Evidence/物件</th><th>可採認性</th><th>來源/缺口</th></tr><tr><td>'+esc_(r[4])+'</td><td>'+adm+'</td><td>'+esc_(r[5])+'</td></tr></table><p><a class=\"button\" target=\"_blank\" rel=\"noopener noreferrer\" data-frozen-artifact-id=\"'+esc_(TTQS_R3_FROZEN_ARTIFACT_.artifactId)+'\" href=\"'+esc_(ttqsR3ArtifactUrl_(TTQS_R3_FROZEN_ARTIFACT_.artifactId))+'\">開啟 FrozenArtifact</a></p><p>R3 路由驗證使用同一既有 CONTROL frozen artifact；正式委員主路徑不依賴協會 Google 帳號。</p></details></article>');}return cardParts.join('');};
doGet=function(e){try{var artifact=e&&e.parameter&&e.parameter.artifact;if(artifact)return HtmlService.createHtmlOutput(ttqsR3ArtifactHtml_(artifact)).setTitle(TTQS_R3_FROZEN_ARTIFACT_.documentTitle).addMetaTag('viewport','width=device-width, initial-scale=1');return HtmlService.createHtmlOutput(render_()).setTitle('TTQS ONE 外部唯讀評核入口｜TEST/SAMPLE').addMetaTag('viewport','width=device-width, initial-scale=1');}catch(err){return HtmlService.createHtmlOutput(ttqsExternalErrorHtml_()).setTitle('TTQS ONE 外部唯讀').addMetaTag('viewport','width=device-width, initial-scale=1');}};
